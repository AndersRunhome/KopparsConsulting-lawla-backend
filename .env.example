# Kopiera till .env. Allt leverantörsspecifikt sätts här – koden känner bara standardytorna.
NODE_ENV=development
PORT=8080

# Postgres med pgvector. Tomt = PGlite i minne (bara utveckling). "pglite:./.pglite" = PGlite på disk.
DATABASE_URL=

JWT_SECRET=byt-ut-mig-till-minst-32-slumpmassiga-tecken
AUTH_RETURN_ORIGINS=http://localhost:5173,https://lawla.kopparsconsulting.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.lawla.kopparsconsulting.com/api/Auth/google/callback
ALLOW_REGISTRATIONS=true
AUTO_APPROVE_REGISTRATIONS=true

# Embeddings: OpenAI-kompatibel endpoint. Tomt = hash-embedder (ingen semantik – bara utveckling/test).
#   TEI lokalt:   http://localhost:8081            (EMBEDDINGS_MODEL=BAAI/bge-m3, DIM=1024)
#   DeepInfra:    https://api.deepinfra.com/v1/openai  + EMBEDDINGS_API_KEY
#   Workers AI:   https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1  + EMBEDDINGS_API_KEY, MODEL=@cf/baai/bge-m3
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIM=1024

# Reranking (TEI/Cohere-kompatibel). Tomt = ingen reranking.
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_FAST_MODEL=claude-haiku-4-5

LAGEN_BASE=https://lagen.nu

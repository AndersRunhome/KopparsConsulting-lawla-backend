# Kopiera till deploy/.env på servern och fyll i. Filen läses bara av api-containern.
API_DOMAIN=api.lawla.kopparsconsulting.com

# Supabase → Connect → "Session pooler" (port 5432), lösenordet från när projektet skapades.
DATABASE_URL=postgresql://postgres.qgcmoghpkirukfgfjfmv:<LÖSENORD>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Skapas av bootstrap.sh om raden lämnas tom.
JWT_SECRET=

AUTH_RETURN_ORIGINS=https://lawla.kopparsconsulting.com,https://lawla-staging.kopparsconsulting.workers.dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.lawla.kopparsconsulting.com/api/Auth/google/callback
ALLOW_REGISTRATIONS=true
AUTO_APPROVE_REGISTRATIONS=false

EMBEDDINGS_URL=https://api.deepinfra.com/v1/openai
EMBEDDINGS_API_KEY=<DEEPINFRA-NYCKEL>
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIM=1024
RERANK_URL=https://api.deepinfra.com/v1/inference/BAAI/bge-reranker-v2-m3
RERANK_API_KEY=<DEEPINFRA-NYCKEL>
RERANK_MODEL=BAAI/bge-reranker-v2-m3

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=<ANTHROPIC-NYCKEL>
LLM_MODEL=claude-sonnet-4-5
LLM_FAST_MODEL=claude-haiku-4-5

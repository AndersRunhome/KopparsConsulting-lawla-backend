{
  "name": "lawla-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lawla – backend för rättsutredningar: ärenden, korpus av rättskällor, hybridsök och analyser.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/ingest/cli.ts",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "argon2": "^0.41.1",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
